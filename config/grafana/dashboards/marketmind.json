{
  "title": "MarketMind AI",
  "uid": "marketmind-overview",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second by path",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (path) (rate(marketmind_requests_total[1m]))", "legendFormat": "{{path}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Request latency p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(marketmind_request_seconds_bucket[5m])))", "legendFormat": "p95" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Server errors per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(marketmind_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx" }]
    }
  ]
}
